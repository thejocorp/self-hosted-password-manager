# Vaultwarden settings. Copy to vaultwarden.env (chmod 600) and edit.
# Full list: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

DOMAIN=https://vault.example.com

# Accounts: only you create the first one (see the README), then nobody signs up on their own.
# Invitations from an organization still work, so family or team members can join when you ask.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SIGNUPS_VERIFY=false

# Password hints help attackers more than users.
SHOW_PASSWORD_HINT=false
PASSWORD_HINTS_ALLOWED=false

# Only you may create organizations (put your account's email here once it exists).
# ORG_CREATION_USERS=you@example.com

# The admin page (/admin). Leave this out to switch the page off, which is the safest state.
# To use it for a while: make a hash with
#   docker compose run --rm vaultwarden /vaultwarden hash
# and paste it in SINGLE quotes, so docker compose leaves the $ signs alone:
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'

# Caddy passes the visitor's address in X-Real-IP; logs and rate limits need it.
IP_HEADER=X-Real-IP

# Built-in brute-force brakes (defaults shown).
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3

# Mail is optional but useful: invitations, new-device alerts, emergency access.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vault@example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=vault@example.com
# SMTP_PASSWORD=...

LOG_LEVEL=warn
EXTENDED_LOGGING=true
TZ=Europe/Berlin
